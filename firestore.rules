rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is a teacher
    // We check the 'users' collection for the current user's role
    function isTeacher() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Only the user themselves or a teacher can read their profile to prevent mass scraping
      allow read: if isAuthenticated() && (request.auth.uid == userId || isTeacher());
      allow write: if isAuthenticated() && request.auth.uid == userId;

      // Explicit rules for user progress
      match /progress/{labId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      // Explicit rules for user custom network topologies
      match /topologies/{topoId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isTeacher());
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      // Explicit rules for teacher evaluations (teachers can write, students can read)
      match /evaluation/{evalDocId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isTeacher());
        allow write: if isAuthenticated() && isTeacher();
      }
    }
  }
}
